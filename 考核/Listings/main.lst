  12          void adjustAngle(unsigned int TGTAngle,unsigned int *currentAngle,unsigned int del)//缓慢转动云台
  13          {
  14   1        if(TGTAngle < *currentAngle)
  15   1        {
  16   2          while(*currentAngle - TGTAngle >= 12)
  17   2          {
  18   3            *currentAngle -= 12;
  19   3            delay(del);
  20   3          }
  21   2        }
  22   1        if(TGTAngle > *currentAngle)
  23   1        {
  24   2          while(TGTAngle - *currentAngle >= 12)
  25   2          {
  26   3            *currentAngle += 12;
  27   3            delay(del);
  28   3          }
  29   2        }
  30   1      }
