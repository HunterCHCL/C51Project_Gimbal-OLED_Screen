  99          unsigned char intToStr(int ld,unsigned char *str)//把ld转换为str，返回值是ld的长度
 100          {
 101   1        unsigned char i;
 102   1        unsigned char len;
 103   1        unsigned char buf[11];
 104   1        if(ld<0){
 105   2          ld = -ld; // 如果是负数则取绝对值
 106   2          *str++ = '-'; //字符串第一位先赋值一个负符号
 107   2          len++;
 108   2        }
 109   1        do{
 110   2          buf[i++] = ld%10+'0'; // 取余运算获取最后一位，拼接上'0',转为ASCLL码
 111   2          ld /= 10; // 除以10向左移动1位
 112   2        }while(ld >0);
 113   1          len += i;
 114   1        while(i-- >0){
 115   2          *str++ = buf[i];
 116   2        }
