  27          void adjustAngle(unsigned int TGTAngle,unsigned int *currentAngle,unsigned int del)
  28          {
  29   1        if(TGTAngle < *currentAngle)
  30   1        {
  31   2          while(*currentAngle - TGTAngle >= 3)
  32   2          {
  33   3            *currentAngle -= 3;
  34   3            delay(del);
  35   3          }
  36   2        }
  37   1        if(TGTAngle > *currentAngle)
  38   1        {
  39   2          while(TGTAngle - *currentAngle >= 3)
  40   2          {
  41   3            *currentAngle += 3;
  42   3            delay(del);
  43   3          }
  44   2        }
  45   1      }
  46          void adjustDutyCycle()
