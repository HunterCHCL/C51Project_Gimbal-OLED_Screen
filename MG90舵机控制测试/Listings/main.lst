  11          void Timer_Routine() interrupt 1
  12          {
  13   1        TL0 = (65536 - 92) % 256;   //设置定时初值
  14   1        TH0 = (65536 - 92) / 256;
  15   1        Counter++;
  16   1        Counter %= 200; //重置counter,现在的值是200,即20ms
  17   1      
  18   1        if(Counter < (servo1_Angle/12)+5)
  19   1        {
  20   2          servo1 = 1;
  21   2        }
  22   1        else
  23   1        {
  24   2          servo1 = 0;
  25   2        }
  26   1      }
  27          void adjustDutyCycle()
  28          {
  29   1        unsigned int i;
  30   1        unsigned int dat=0;
  31   1        for(i=1;buf[i]!='E';i++)
  32   1        {
