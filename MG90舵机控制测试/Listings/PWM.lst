   3          void PWM_Init()
   4          {
   5   1          TMOD &= 0xF0;    // 清零 T0 低4位
   6   1          TMOD |= 0x01;    // T0 模式1，16位定时器
   7   1          TH0 = (65536 - 92) / 256; // 定时器初值=65536-(定时时间(us)*晶振频率(MHz)/12)，定时100
             -us
   8   1          TL0 = (65536 - 92) % 256;
   9   1          TF0=0;  //TimerFlag,溢出标志，由硬件自动置位和清除
  10   1          ET0 = 1;  // 允许 T0 中断
  11   1          EA = 1; // 总中断使能
  12   1          TR0 = 1;  // 启动 T0
  13   1      }
